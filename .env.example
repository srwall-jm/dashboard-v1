# Browser-side (Vite). Optional agency-wide fallback; the token typed in Settings takes priority.
VITE_GOOGLE_ADS_DEVELOPER_TOKEN=

# Server-side (Cloudflare Pages Functions). Do NOT prefix with VITE_.
# Production: Cloudflare dashboard > Pages project > Settings > Variables and Secrets.
# Local `npm run preview`: copy these two lines into a .dev.vars file.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-pro-preview
